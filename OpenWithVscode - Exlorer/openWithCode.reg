Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\*\shell\OpenWithVSCode]
@="Open with VSCode"
"Icon"="%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe"

[HKEY_CLASSES_ROOT\*\shell\OpenWithVSCode\command]
@="\"Code.exe\" \"%1\""

[HKEY_CLASSES_ROOT\Directory\shell\OpenWithVSCode]
@="Open with VSCode"
"Icon"="%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe"

[HKEY_CLASSES_ROOT\Directory\shell\OpenWithVSCode\command]
@="\"Code.exe\" \"%1\""
